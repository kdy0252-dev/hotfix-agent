SPRING_PROFILES_ACTIVE=local

BITBUCKET_BASE_URL=https://api.bitbucket.org/2.0
BITBUCKET_GIT_BASE_URL=https://bitbucket.org
BITBUCKET_WORKSPACE=autocrypt
BITBUCKET_REPOSITORY=fms
BITBUCKET_TOKEN=

JENKINS_BASE_URL=https://jenkins.autocrypt-fms.io
JENKINS_ROOT_JOB=FMS-EU
JENKINS_USER=autocrypt
JENKINS_TOKEN=
JENKINS_TLS_VERIFY=false

GRAFANA_BASE_URL=https://prod-grafana.autocrypt-fms.io
GRAFANA_TOKEN=
GRAFANA_TLS_VERIFY=false
GRAFANA_LOKI_DATASOURCE_UID=
GRAFANA_PROMETHEUS_DATASOURCE_UID=
GRAFANA_TEMPO_DATASOURCE_UID=
OBSERVABILITY_SERVICE_DISPLAY_NAME=TARGET SERVICE
OBSERVABILITY_REGION=eu
OBSERVABILITY_APPLICATION=app
OBSERVABILITY_NAMESPACE_TEMPLATE=fms-eu-%s
OBSERVABILITY_SERVICE_NAME_TEMPLATE=fms-eu-%s-app

AGENT_MODE=REPORT_ONLY
AGENT_FMS_REPOSITORY_PATH=/Users/your-name/workspace/fms
AGENT_ANALYSIS_TTL=24h
AGENT_API_BIND_ADDRESS=127.0.0.1
AGENT_AI_TRIAGE_MAX_INPUT_TOKENS=8000
AGENT_AI_TRIAGE_MAX_OUTPUT_TOKENS=1500
AGENT_AI_REASONING_MAX_INPUT_TOKENS=16000
AGENT_AI_REASONING_MAX_OUTPUT_TOKENS=4000
AGENT_AI_REVIEW_MAX_INPUT_TOKENS=8000
AGENT_AI_REVIEW_MAX_OUTPUT_TOKENS=1500
AGENT_AI_PROVIDER_MAX_ATTEMPTS=1
AGENT_AI_DATA_BINDING_MAX_ATTEMPTS=1
AGENT_PARITY_MAX_WORKERS=2
AGENT_NEWMAN_WORKSPACE_ROOT=/Users/your-name/workspace/my-agent/.agent/runtime

LITELLM_BASE_URL=https://aigw.autocrypt.co.kr
LITELLM_API_KEY=
LITELLM_MODEL=chatgpt-5.6-luna
# Optional. Defaults to LITELLM_MODEL when omitted.
# LITELLM_EVALUATION_MODEL=gemma-4.26b
LITELLM_TRIAGE_MODEL=claude-haiku-4-5
LITELLM_REASONING_MODEL=chatgpt-5.6-sol
LITELLM_REVIEW_MODEL=claude-sonnet-5

OPENAI_API_KEY=
